# Life Board — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to Git

# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: Cover Letter generation with Claude ─────────────────────────────
# Without this, cover letters fall back to Groq (free, slightly lower quality)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: Supabase (cloud persistence) ────────────────────────────────────
# Without these, the app uses localStorage. To enable cloud sync:
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the Supabase SQL editor
# 3. Fill in the values below
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
