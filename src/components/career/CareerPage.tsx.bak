'use client'
import { useState, useEffect, useRef } from 'react'
import type { Page } from '@/components/layout/Sidebar'

type RunStep = 'idle' | 'manager_open' | 'profile' | 'search' | 'market_scout' | 'mentor' | 'manager_close' | 'done' | 'error'

interface Job {
  id: string; title: string; company: string; location: string; salary?: string
  description: string; url: string; linkedin_url?: string; company_url?: string
  source: string; ats_score: number; match_reasons: string[]; posted_date?: string
}
interface SkillGap { skill: string; priority: 'high'|'medium'|'low'; reason: string; learning_resource?: string; estimated_time?: string }
interface CompanySignal { company: string; job_title: string; job_url: string; ats_score: number; apply_priority: 'high'|'medium'|'low'; priority_reason: string; tech_stack_match: string; culture_signals: string[] }
interface PipelineResult { filtered_jobs: Job[]; skill_gaps: SkillGap[]; company_signals: CompanySignal[]; cover_letters: Record<string,string>; daily_summary: string; career_insight?: string; cv_profile?: Record<string,any>; interview_prep?: Record<string,any> }

const STEPS: { id: RunStep; icon: string; label: string; agentName: string }[] = [
  { id:'manager_open', icon:'🎯', label:'מנהל — אסטרטגיה',  agentName:'מנהל'     },
  { id:'profile',      icon:'👤', label:'פרופיל — ניתוח CV', agentName:'פרופיל'   },
  { id:'search',       icon:'🔍', label:'מחפש — משרות',      agentName:'מחפש'     },
  { id:'market_scout', icon:'🕵️', label:'חוקר שוק — חברות', agentName:'חוקר שוק' },
  { id:'mentor',       icon:'🧭', label:'מנטור — ייעוץ',     agentName:'מנטור'    },
]
const AGENT_COLORS: Record<string,{color:string;bg:string}> = {
  manager:      {color:'#6366f1',bg:'#6366f122'},
  profile:      {color:'#ec4899',bg:'#ec489922'},
  finder:       {color:'#06b6d4',bg:'#06b6d422'},
  market_scout: {color:'#8b5cf6',bg:'#8b5cf622'},
  mentor:       {color:'#10b981',bg:'#10b98122'},
}

function AtsBar({ score }: { score: number }) {
  const color = score>=75?'#4ade80':score>=50?'#facc15':'#f87171'
  return (
    <div style={{display:'flex',alignItems:'center',gap:'8px',marginTop:'6px'}}>
      <div style={{flex:1,height:'5px',background:'rgba(255,255,255,0.1)',borderRadius:'3px',overflow:'hidden'}}>
        <div style={{width:`${score}%`,height:'100%',background:color,borderRadius:'3px',transition:'width 0.5s ease'}}/>
      </div>
      <span style={{fontSize:'11px',color,fontWeight:600,minWidth:'28px'}}>{score}%</span>
    </div>
  )
}
function ScoreCircle({ score }: { score: number }) {
  const color = score>=75?'#4ade80':score>=50?'#facc15':'#f87171'
  const r=20,circ=2*Math.PI*r,off=circ*(1-score/100)
  return (
    <svg width="50" height="50" style={{flexShrink:0}}>
      <circle cx="25" cy="25" r={r} fill="none" stroke="rgba(255,255,255,0.08)" strokeWidth="4"/>
      <circle cx="25" cy="25" r={r} fill="none" stroke={color} strokeWidth="4"
        strokeDasharray={circ} strokeDashoffset={off} strokeLinecap="round"
        transform="rotate(-90 25 25)" style={{transition:'stroke-dashoffset 0.5s ease'}}/>
      <text x="25" y="29" textAnchor="middle" fontSize="11" fontWeight="700" fill={color}>{score}</text>
    </svg>
  )
}

function AgentStatusPanel({ currentStep, result }: { currentStep: RunStep; result: PipelineResult|null }) {
  const agents = [
    {id:'manager',      name:'מנהל',      emoji:'🎯', step:'manager_open'  as RunStep},
    {id:'profile',      name:'פרופיל',    emoji:'👤', step:'profile'       as RunStep},
    {id:'finder',       name:'מחפש',      emoji:'🔍', step:'search'        as RunStep},
    {id:'market_scout', name:'חוקר שוק',  emoji:'🕵️', step:'market_scout'  as RunStep},
    {id:'mentor',       name:'מנטור',     emoji:'🧭', step:'mentor'        as RunStep},
  ]
  const stepOrder: RunStep[] = ['manager_open','profile','search','market_scout','mentor','manager_close','done']
  return (
    <div style={{display:'flex',flexDirection:'column',gap:'8px'}}>
      {agents.map(agent => {
        const ac = AGENT_COLORS[agent.id]||AGENT_COLORS.manager
        const isActive = currentStep===agent.step
        const isDone = stepOrder.indexOf(currentStep)>stepOrder.indexOf(agent.step)
        return (
          <div key={agent.id} style={{
            padding:'10px 12px',borderRadius:'12px',
            background:isActive?ac.bg:'rgba(255,255,255,0.03)',
            border:`1px solid ${isActive?ac.color:isDone?'rgba(74,222,128,0.2)':'rgba(255,255,255,0.06)'}`,
            display:'flex',alignItems:'center',gap:'10px',transition:'all 0.3s ease',
          }}>
            <span style={{fontSize:'18px'}}>{agent.emoji}</span>
            <div style={{flex:1,minWidth:0}}>
              <div style={{fontSize:'13px',fontWeight:600,color:isActive?ac.color:isDone?'#4ade80':'#64748b'}}>
                {agent.name}
              </div>
              {isActive&&<div style={{fontSize:'11px',color:'#94a3b8',marginTop:'2px',animation:'fadeIn 0.3s ease'}}>
                {agent.id==='manager'?'מנסח אסטרטגיה...':agent.id==='profile'?'מנתח CV...':agent.id==='finder'?'סורק משרות...':agent.id==='market_scout'?'חוקר חברות...':'מכין ייעוץ...'}
              </div>}
              {isDone&&agent.id==='finder'&&result&&<div style={{fontSize:'11px',color:'#4ade80',marginTop:'2px'}}>{result.filtered_jobs?.length||0} משרות נמצאו</div>}
              {isDone&&agent.id==='market_scout'&&result&&<div style={{fontSize:'11px',color:'#4ade80',marginTop:'2px'}}>{result.company_signals?.length||0} חברות נותחו</div>}
              {isDone&&agent.id==='mentor'&&result&&<div style={{fontSize:'11px',color:'#4ade80',marginTop:'2px'}}>{Object.keys(result.cover_letters||{}).length} מכתבים מוכנים</div>}
              {isDone&&agent.id==='profile'&&result?.cv_profile&&<div style={{fontSize:'11px',color:'#4ade80',marginTop:'2px'}}>{result.cv_profile.seniority} {result.cv_profile.domain}</div>}
            </div>
            <div style={{fontSize:'14px'}}>
              {isActive?<span style={{animation:'spin 1s linear infinite',display:'inline-block'}}>⟳</span>:isDone?'✓':'○'}
            </div>
          </div>
        )
      })}
      {result?.skill_gaps&&result.skill_gaps.length>0&&(
        <div style={{marginTop:'6px',padding:'12px',background:'rgba(139,92,246,0.08)',border:'1px solid rgba(139,92,246,0.2)',borderRadius:'12px'}}>
          <div style={{fontSize:'12px',fontWeight:600,color:'#a78bfa',marginBottom:'8px'}}>🎯 פערי כישורים</div>
          {result.skill_gaps.slice(0,3).map((gap,i)=>(
            <div key={i} style={{fontSize:'12px',color:'#94a3b8',marginBottom:'4px',display:'flex',justifyContent:'space-between'}}>
              <span>• {gap.skill}</span>
              <span style={{color:gap.priority==='high'?'#f87171':gap.priority==='medium'?'#facc15':'#94a3b8',fontSize:'10px'}}>
                {gap.priority==='high'?'דחוף':gap.priority==='medium'?'בינוני':'נמוך'}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>
  )
}

function SwipeJobCard({ job, onSwipe, appliedJobs, skippedJobs }: { job:Job; onSwipe:(id:string,dir:'apply'|'skip')=>void; appliedJobs:string[]; skippedJobs:string[] }) {
  const [urlInput,setUrlInput]=useState('')
  const [urlAnalysis,setUrlAnalysis]=useState<string|null>(null)
  const [analyzingUrl,setAnalyzingUrl]=useState(false)
  const isApplied=appliedJobs.includes(job.id)
  const isSkipped=skippedJobs.includes(job.id)
  const externalUrl=job.linkedin_url||job.company_url||job.url
  const externalIcon=job.linkedin_url?'🔗':job.company_url?'🌐':'🔗'

  async function analyzeUrl() {
    if(!urlInput.trim())return
    setAnalyzingUrl(true); setUrlAnalysis(null)
    try {
      const res=await fetch('/api/analyze-job',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:urlInput})})
      const data=await res.json()
      setUrlAnalysis(data.analysis||'לא נמצא ניתוח')
    } catch { setUrlAnalysis('שגיאה בניתוח') }
    finally { setAnalyzingUrl(false) }
  }

  return (
    <div style={{background:'rgba(255,255,255,0.04)',border:'1px solid rgba(255,255,255,0.1)',borderRadius:'16px',padding:'16px',marginBottom:'10px',opacity:isSkipped?0.4:1,transition:'all 0.3s ease'}}>
      <div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-start',marginBottom:'8px'}}>
        <div style={{flex:1,minWidth:0,paddingLeft:'12px'}}>
          <div style={{fontSize:'15px',fontWeight:700,color:'#f1f5f9',marginBottom:'2px'}}>{job.title}</div>
          <div style={{fontSize:'13px',color:'#94a3b8'}}>{job.company} · {job.location}</div>
        </div>
        <ScoreCircle score={job.ats_score}/>
      </div>
      <AtsBar score={job.ats_score}/>
      {job.match_reasons&&job.match_reasons.length>0&&(
        <div style={{display:'flex',flexWrap:'wrap',gap:'6px',marginTop:'10px'}}>
          {job.match_reasons.slice(0,3).map((r,i)=>(
            <span key={i} style={{padding:'3px 8px',borderRadius:'20px',background:'rgba(99,102,241,0.15)',border:'1px solid rgba(99,102,241,0.3)',fontSize:'11px',color:'#a5b4fc'}}>{r}</span>
          ))}
        </div>
      )}
      {job.salary&&<div style={{marginTop:'8px',fontSize:'12px',color:'#4ade80'}}>💰 {job.salary}</div>}
      <a href={externalUrl} target="_blank" rel="noopener noreferrer" style={{display:'inline-flex',alignItems:'center',gap:'4px',marginTop:'10px',fontSize:'12px',color:'#60a5fa',textDecoration:'none'}}>
        {externalIcon} {job.linkedin_url?'LinkedIn':job.company_url?'אתר החברה':'קישור'}
      </a>
      <div style={{marginTop:'12px',paddingTop:'12px',borderTop:'1px solid rgba(255,255,255,0.06)'}}>
        <div style={{fontSize:'11px',color:'#64748b',marginBottom:'6px'}}>הדבק URL ידני לניתוח</div>
        <div style={{display:'flex',gap:'6px'}}>
          <input value={urlInput} onChange={e=>setUrlInput(e.target.value)} placeholder="https://..."
            style={{flex:1,background:'rgba(255,255,255,0.06)',border:'1px solid rgba(255,255,255,0.12)',borderRadius:'8px',padding:'6px 10px',fontSize:'12px',color:'#e2e8f0',outline:'none'}}/>
          <button onClick={analyzeUrl} disabled={analyzingUrl||!urlInput.trim()}
            style={{padding:'6px 12px',borderRadius:'8px',background:'#6366f1',border:'none',color:'white',fontSize:'12px',cursor:'pointer',opacity:analyzingUrl||!urlInput.trim()?0.5:1}}>
            {analyzingUrl?'...':'נתח'}
          </button>
        </div>
        {urlAnalysis&&(
          <div style={{marginTop:'8px',padding:'8px 10px',background:'rgba(99,102,241,0.1)',border:'1px solid rgba(99,102,241,0.2)',borderRadius:'8px',fontSize:'12px',color:'#94a3b8',lineHeight:1.5}}>
            {urlAnalysis}
          </div>
        )}
      </div>
      {!isApplied&&!isSkipped&&(
        <div style={{display:'flex',gap:'8px',marginTop:'12px'}}>
          <button onClick={()=>onSwipe(job.id,'skip')} style={{flex:1,padding:'8px',borderRadius:'10px',background:'rgba(248,113,113,0.1)',border:'1px solid rgba(248,113,113,0.3)',color:'#f87171',fontSize:'13px',cursor:'pointer',fontWeight:600}}>✕ דלג</button>
          <button onClick={()=>onSwipe(job.id,'apply')} style={{flex:1,padding:'8px',borderRadius:'10px',background:'rgba(74,222,128,0.1)',border:'1px solid rgba(74,222,128,0.3)',color:'#4ade80',fontSize:'13px',cursor:'pointer',fontWeight:600}}>✓ הגש</button>
        </div>
      )}
      {isApplied&&<div style={{marginTop:'10px',textAlign:'center',fontSize:'13px',color:'#4ade80',fontWeight:600}}>✓ הוגש</div>}
    </div>
  )
}

function ApplicationsPanel({ jobs, appliedJobs, skippedJobs }: { jobs:Job[]; appliedJobs:string[]; skippedJobs:string[] }) {
  const [resumeUploadState,setResumeUploadState]=useState<'idle'|'uploading'|'done'|'error'>('idle')
  const [resumeText,setResumeText]=useState('')
  const fileRef=useRef<HTMLInputElement>(null)
  const applied=jobs.filter(j=>appliedJobs.includes(j.id))
  const skipped=jobs.filter(j=>skippedJobs.includes(j.id))

  async function handleFileUpload(e: React.ChangeEvent<HTMLInputElement>) {
    const file=e.target.files?.[0]; if(!file)return
    setResumeUploadState('uploading')
    try {
      const form=new FormData(); form.append('file',file)
      const res=await fetch('/api/parse-resume',{method:'POST',body:form})
      const data=await res.json()
      if(data.text){setResumeText(data.text);setResumeUploadState('done')}
      else setResumeUploadState('error')
    } catch { setResumeUploadState('error') }
  }

  return (
    <div style={{display:'flex',flexDirection:'column',gap:'16px'}}>
      <div style={{padding:'16px',background:'rgba(99,102,241,0.08)',border:'1px solid rgba(99,102,241,0.2)',borderRadius:'16px'}}>
        <div style={{fontSize:'14px',fontWeight:700,color:'#a5b4fc',marginBottom:'12px'}}>📄 קורות חיים</div>
        <input ref={fileRef} type="file" accept=".pdf,.doc,.docx,.txt" onChange={handleFileUpload} style={{display:'none'}}/>
        <button onClick={()=>fileRef.current?.click()} disabled={resumeUploadState==='uploading'} style={{
          width:'100%',padding:'12px',borderRadius:'10px',
          background:resumeUploadState==='done'?'rgba(74,222,128,0.1)':resumeUploadState==='error'?'rgba(248,113,113,0.1)':'rgba(99,102,241,0.15)',
          border:`1px dashed ${resumeUploadState==='done'?'#4ade80':resumeUploadState==='error'?'#f87171':'#6366f1'}`,
          color:resumeUploadState==='done'?'#4ade80':resumeUploadState==='error'?'#f87171':'#a5b4fc',
          fontSize:'13px',cursor:'pointer',transition:'all 0.2s ease',
        }}>
          {resumeUploadState==='uploading'?'⟳ מעלה...':resumeUploadState==='done'?'✓ קורות חיים הועלו':resumeUploadState==='error'?'✕ שגיאה — נסה שוב':'📎 העלה PDF / Word'}
        </button>
        <div style={{margin:'12px 0',fontSize:'12px',color:'#475569',textAlign:'center'}}>— או —</div>
        <textarea value={resumeText} onChange={e=>setResumeText(e.target.value)} placeholder="הדבק את תוכן קורות החיים כאן..." rows={4}
          style={{width:'100%',background:'rgba(255,255,255,0.05)',border:'1px solid rgba(255,255,255,0.1)',borderRadius:'10px',padding:'10px',fontSize:'12px',color:'#e2e8f0',resize:'vertical',outline:'none',boxSizing:'border-box',lineHeight:1.5}}/>
      </div>
      {applied.length>0&&(
        <div>
          <div style={{fontSize:'13px',fontWeight:600,color:'#4ade80',marginBottom:'8px'}}>✓ הוגש ({applied.length})</div>
          {applied.map(job=>(
            <div key={job.id} style={{padding:'10px 12px',borderRadius:'10px',background:'rgba(74,222,128,0.06)',border:'1px solid rgba(74,222,128,0.15)',marginBottom:'6px',display:'flex',justifyContent:'space-between',alignItems:'center'}}>
              <div>
                <div style={{fontSize:'13px',color:'#e2e8f0',fontWeight:600}}>{job.title}</div>
                <div style={{fontSize:'11px',color:'#64748b'}}>{job.company}</div>
              </div>
              <a href={job.linkedin_url||job.company_url||job.url} target="_blank" rel="noopener noreferrer" style={{fontSize:'14px',color:'#60a5fa',textDecoration:'none'}}>
                {job.linkedin_url?'🔗':'🌐'}
              </a>
            </div>
          ))}
        </div>
      )}
      {skipped.length>0&&(
        <div>
          <div style={{fontSize:'13px',fontWeight:600,color:'#64748b',marginBottom:'8px'}}>✕ דולגו ({skipped.length})</div>
          {skipped.map(job=>(
            <div key={job.id} style={{padding:'8px 12px',borderRadius:'10px',background:'rgba(255,255,255,0.03)',border:'1px solid rgba(255,255,255,0.06)',marginBottom:'6px'}}>
              <div style={{fontSize:'12px',color:'#64748b'}}>{job.title} — {job.company}</div>
            </div>
          ))}
        </div>
      )}
      {applied.length===0&&skipped.length===0&&(
        <div style={{textAlign:'center',color:'#475569',fontSize:'13px',padding:'24px 0'}}>עוד אין פניות — הגש משרות מהטאב הראשי</div>
      )}
    </div>
  )
}

interface CareerPageProps { onNavigate: (page: Page) => void }

export default function CareerPage({ onNavigate }: CareerPageProps) {
  const [activePanel,setActivePanel]=useState(0)
  const [jobsSubTab,setJobsSubTab]=useState<'jobs'|'applications'>('jobs')
  const [currentStep,setCurrentStep]=useState<RunStep>('idle')
  const [result,setResult]=useState<PipelineResult|null>(null)
  const [loading,setLoading]=useState(false)
  const [error,setError]=useState<string|null>(null)
  const [appliedJobs,setAppliedJobs]=useState<string[]>([])
  const [skippedJobs,setSkippedJobs]=useState<string[]>([])
  const [activityLog,setActivityLog]=useState<{time:string;text:string;type?:string}[]>([])

  function addLog(text:string,type?:string) {
    const time=new Date().toLocaleTimeString('he-IL',{hour:'2-digit',minute:'2-digit'})
    setActivityLog(prev=>[{time,text,type},...prev].slice(0,50))
  }

  async function runPipeline() {
    setLoading(true);setError(null);setResult(null);setActivityLog([])
    addLog('מתחיל ריצת סוכנים...','start')
    const stepSeq: RunStep[]=['manager_open','profile','search','market_scout','mentor','manager_close']
    const delays=[800,1200,2000,1500,1800,600]
    for(let i=0;i<stepSeq.length;i++){
      const step=stepSeq[i]; setCurrentStep(step)
      const sd=STEPS.find(s=>s.id===step)
      if(sd)addLog(`${sd.icon} ${sd.agentName} פועל...`,'agent')
      await new Promise(r=>setTimeout(r,delays[i]))
    }
    try {
      const res=await fetch('/api/run-pipeline',{method:'POST'})
      const data:PipelineResult=await res.json()
      setResult(data);setCurrentStep('done')
      addLog(`✓ הושלם — ${data.filtered_jobs?.length||0} משרות`,'done')
      if(data.daily_summary)addLog(data.daily_summary,'summary')
      if(data.career_insight)addLog(`💡 ${data.career_insight}`,'insight')
    } catch(err:any) {
      setCurrentStep('error');setError(err.message||'שגיאה')
      addLog('✕ שגיאה','error')
    } finally { setLoading(false) }
  }

  function handleSwipe(id:string,dir:'apply'|'skip') {
    if(dir==='apply')setAppliedJobs(p=>[...p,id])
    else setSkippedJobs(p=>[...p,id])
  }

  const visibleJobs=result?.filtered_jobs?.filter(j=>!skippedJobs.includes(j.id))||[]
  const panels=[{icon:'🏠',label:'בית'},{icon:'💼',label:'משרות'},{icon:'📊',label:'ניתוח'},{icon:'📋',label:'יומן'}]

  return (
    <div dir="rtl" style={{minHeight:'100vh',background:'linear-gradient(135deg,#0f0f1a 0%,#1a1a2e 50%,#16213e 100%)',display:'flex',flexDirection:'column',fontFamily:"'Segoe UI',system-ui,sans-serif",color:'#e2e8f0'}}>
      <style>{`
        @keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
        @keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
        input::placeholder,textarea::placeholder{color:#475569}
        *::-webkit-scrollbar{width:4px}
        *::-webkit-scrollbar-track{background:transparent}
        *::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.1);border-radius:2px}
      `}</style>

      {/* Header */}
      <div style={{padding:'16px 20px 12px',background:'rgba(255,255,255,0.03)',borderBottom:'1px solid rgba(255,255,255,0.07)',display:'flex',alignItems:'center',justifyContent:'space-between'}}>
        <div style={{display:'flex',alignItems:'center',gap:'10px'}}>
          <button onClick={()=>onNavigate('home')} style={{background:'none',border:'none',color:'#64748b',cursor:'pointer',fontSize:'18px',padding:'2px'}}>←</button>
          <div>
            <h1 style={{margin:0,fontSize:'18px',fontWeight:700,color:'#f1f5f9',lineHeight:1.2}}>💼 Life Board Career</h1>
            <p style={{margin:0,fontSize:'11px',color:'#64748b'}}>
              {loading?`${STEPS.find(s=>s.id===currentStep)?.agentName||'...'} פועל`:result?`${result.filtered_jobs?.length||0} משרות`:'5 סוכני AI'}
            </p>
          </div>
        </div>
        <div style={{display:'flex',gap:'8px',alignItems:'center'}}>
          <button onClick={()=>onNavigate('agents')} style={{padding:'6px 10px',borderRadius:'8px',background:'rgba(99,102,241,0.15)',border:'1px solid rgba(99,102,241,0.3)',color:'#a5b4fc',fontSize:'12px',cursor:'pointer'}}>🤖 סוכנים</button>
          <button onClick={runPipeline} disabled={loading} style={{padding:'8px 16px',borderRadius:'10px',background:loading?'rgba(99,102,241,0.3)':'linear-gradient(135deg,#6366f1,#8b5cf6)',border:'none',color:'white',fontSize:'13px',fontWeight:600,cursor:loading?'not-allowed':'pointer',display:'flex',alignItems:'center',gap:'6px',opacity:loading?0.8:1}}>
            {loading?<><span style={{animation:'spin 1s linear infinite',display:'inline-block'}}>⟳</span> רץ...</>:<>▶ הפעל</>}
          </button>
        </div>
      </div>

      {/* Progress */}
      {loading&&(
        <div style={{padding:'8px 20px',background:'rgba(99,102,241,0.05)',borderBottom:'1px solid rgba(255,255,255,0.05)'}}>
          <div style={{display:'flex',gap:'4px',alignItems:'center',overflowX:'auto',paddingBottom:'2px'}}>
            {STEPS.map((step,i)=>{
              const ord: RunStep[]=['manager_open','profile','search','market_scout','mentor','manager_close']
              const ci=ord.indexOf(currentStep),si=ord.indexOf(step.id)
              const isA=currentStep===step.id,isDo=ci>si
              return (
                <div key={step.id} style={{display:'flex',alignItems:'center',gap:'4px',flexShrink:0}}>
                  <div style={{padding:'3px 8px',borderRadius:'20px',background:isA?'#6366f1':isDo?'rgba(74,222,128,0.15)':'rgba(255,255,255,0.05)',border:`1px solid ${isA?'#6366f1':isDo?'rgba(74,222,128,0.3)':'rgba(255,255,255,0.08)'}`,fontSize:'11px',color:isA?'white':isDo?'#4ade80':'#64748b',display:'flex',alignItems:'center',gap:'4px'}}>
                    {isA?<span style={{animation:'spin 1s linear infinite',display:'inline-block',fontSize:'10px'}}>⟳</span>:isDo?'✓':step.icon}
                    {step.agentName}
                  </div>
                  {i<STEPS.length-1&&<span style={{color:'#334155',fontSize:'10px'}}>›</span>}
                </div>
              )
            })}
          </div>
        </div>
      )}

      {error&&<div style={{margin:'12px 16px',padding:'12px',background:'rgba(248,113,113,0.1)',border:'1px solid rgba(248,113,113,0.3)',borderRadius:'12px',fontSize:'13px',color:'#f87171'}}>✕ {error}</div>}

      {/* Content */}
      <div style={{flex:1,overflow:'hidden',display:'flex',flexDirection:'column'}}>
        {/* Panel 0: Home */}
        {activePanel===0&&(
          <div style={{flex:1,overflowY:'auto',padding:'16px'}}>
            {!result&&!loading&&(
              <div style={{textAlign:'center',padding:'40px 16px'}}>
                <div style={{fontSize:'48px',marginBottom:'16px'}}>🚀</div>
                <h2 style={{fontSize:'20px',fontWeight:700,color:'#f1f5f9',margin:'0 0 8px'}}>מוכן להתחיל?</h2>
                <p style={{color:'#64748b',fontSize:'14px',margin:'0 0 24px',lineHeight:1.6}}>5 סוכני AI יחפשו, ינתחו ויכינו אותך<br/>למשרות הטובות ביותר עבורך</p>
                <button onClick={runPipeline} style={{padding:'14px 32px',borderRadius:'14px',background:'linear-gradient(135deg,#6366f1,#8b5cf6)',border:'none',color:'white',fontSize:'16px',fontWeight:700,cursor:'pointer'}}>▶ הפעל סוכנים</button>
              </div>
            )}
            {(loading||result)&&<AgentStatusPanel currentStep={currentStep} result={result}/>}
            {result?.daily_summary&&(
              <div style={{marginTop:'16px',padding:'16px',background:'rgba(99,102,241,0.1)',border:'1px solid rgba(99,102,241,0.25)',borderRadius:'16px'}}>
                <div style={{fontSize:'12px',fontWeight:600,color:'#a5b4fc',marginBottom:'8px'}}>📋 סיכום יומי</div>
                <p style={{margin:0,fontSize:'14px',color:'#cbd5e1',lineHeight:1.6}}>{result.daily_summary}</p>
              </div>
            )}
            {result?.career_insight&&(
              <div style={{marginTop:'12px',padding:'14px',background:'rgba(16,185,129,0.08)',border:'1px solid rgba(16,185,129,0.2)',borderRadius:'14px'}}>
                <div style={{fontSize:'12px',fontWeight:600,color:'#34d399',marginBottom:'6px'}}>💡 תובנת שבוע</div>
                <p style={{margin:0,fontSize:'13px',color:'#94a3b8',lineHeight:1.6}}>{result.career_insight}</p>
              </div>
            )}
          </div>
        )}

        {/* Panel 1: Jobs + Applications */}
        {activePanel===1&&(
          <div style={{flex:1,overflowY:'auto',padding:'16px',display:'flex',flexDirection:'column',gap:'10px'}}>
            <div style={{display:'flex',gap:'8px'}}>
              {[{key:'jobs' as const,label:'💼 משרות'},{key:'applications' as const,label:'📋 בקשות'}].map(tab=>(
                <button key={tab.key} onClick={()=>setJobsSubTab(tab.key)} style={{padding:'7px 14px',borderRadius:'10px',background:jobsSubTab===tab.key?'rgba(99,102,241,0.25)':'rgba(255,255,255,0.05)',border:`1px solid ${jobsSubTab===tab.key?'rgba(99,102,241,0.5)':'rgba(255,255,255,0.08)'}`,color:jobsSubTab===tab.key?'#a5b4fc':'#64748b',fontSize:'13px',cursor:'pointer',fontWeight:jobsSubTab===tab.key?600:400,transition:'all 0.2s ease'}}>
                  {tab.label}
                </button>
              ))}
            </div>
            {jobsSubTab==='jobs'?(
              visibleJobs.length>0?(
                visibleJobs.map(job=><SwipeJobCard key={job.id} job={job} onSwipe={handleSwipe} appliedJobs={appliedJobs} skippedJobs={skippedJobs}/>)
              ):(
                <div style={{textAlign:'center',color:'#475569',fontSize:'14px',padding:'40px 0'}}>
                  {result?'אין משרות — הפעל מחדש':'הפעל את הסוכנים לחיפוש משרות'}
                </div>
              )
            ):(
              <ApplicationsPanel jobs={result?.filtered_jobs||[]} appliedJobs={appliedJobs} skippedJobs={skippedJobs}/>
            )}
          </div>
        )}

        {/* Panel 2: Analysis */}
        {activePanel===2&&(
          <div style={{flex:1,overflowY:'auto',padding:'16px',display:'flex',flexDirection:'column',gap:'12px'}}>
            {result?.company_signals&&result.company_signals.length>0&&(
              <div>
                <div style={{fontSize:'13px',fontWeight:600,color:'#94a3b8',marginBottom:'10px'}}>🏢 ניתוח חברות ({result.company_signals.length})</div>
                {result.company_signals.map((sig,i)=>(
                  <div key={i} style={{padding:'12px 14px',borderRadius:'12px',background:'rgba(255,255,255,0.04)',border:'1px solid rgba(255,255,255,0.08)',marginBottom:'8px'}}>
                    <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:'6px'}}>
                      <div style={{fontSize:'14px',fontWeight:700,color:'#f1f5f9'}}>{sig.company}</div>
                      <span style={{padding:'3px 8px',borderRadius:'20px',fontSize:'11px',background:sig.apply_priority==='high'?'rgba(74,222,128,0.15)':sig.apply_priority==='medium'?'rgba(250,204,21,0.15)':'rgba(255,255,255,0.05)',color:sig.apply_priority==='high'?'#4ade80':sig.apply_priority==='medium'?'#facc15':'#64748b'}}>
                        {sig.apply_priority==='high'?'עדיפות גבוהה':sig.apply_priority==='medium'?'בינוני':'נמוך'}
                      </span>
                    </div>
                    <div style={{fontSize:'12px',color:'#64748b',marginBottom:'4px'}}>{sig.job_title}</div>
                    <div style={{fontSize:'12px',color:'#94a3b8'}}>{sig.priority_reason}</div>
                    <AtsBar score={sig.ats_score}/>
                  </div>
                ))}
              </div>
            )}
            {result?.skill_gaps&&result.skill_gaps.length>0&&(
              <div>
                <div style={{fontSize:'13px',fontWeight:600,color:'#94a3b8',marginBottom:'10px'}}>🎯 פערי כישורים</div>
                {result.skill_gaps.map((gap,i)=>(
                  <div key={i} style={{padding:'10px 12px',borderRadius:'12px',background:'rgba(139,92,246,0.08)',border:'1px solid rgba(139,92,246,0.15)',marginBottom:'6px'}}>
                    <div style={{display:'flex',justifyContent:'space-between',marginBottom:'4px'}}>
                      <span style={{fontSize:'13px',fontWeight:600,color:'#e2e8f0'}}>{gap.skill}</span>
                      <span style={{fontSize:'11px',color:gap.priority==='high'?'#f87171':gap.priority==='medium'?'#facc15':'#94a3b8'}}>
                        {gap.priority==='high'?'🔴 דחוף':gap.priority==='medium'?'🟡 בינוני':'🟢 נמוך'}
                      </span>
                    </div>
                    <div style={{fontSize:'11px',color:'#64748b'}}>{gap.reason}</div>
                    {gap.learning_resource&&<div style={{fontSize:'11px',color:'#60a5fa',marginTop:'4px'}}>📚 {gap.learning_resource} · {gap.estimated_time}</div>}
                  </div>
                ))}
              </div>
            )}
            {!result&&<div style={{textAlign:'center',color:'#475569',fontSize:'14px',padding:'40px 0'}}>הפעל את הסוכנים לקבלת ניתוח</div>}
          </div>
        )}

        {/* Panel 3: Activity Log */}
        {activePanel===3&&(
          <div style={{flex:1,overflowY:'auto',padding:'16px'}}>
            <div style={{fontSize:'13px',fontWeight:600,color:'#64748b',marginBottom:'12px'}}>📋 יומן פעילות</div>
            {activityLog.length===0?(
              <div style={{textAlign:'center',color:'#475569',fontSize:'14px',padding:'40px 0'}}>אין פעילות עדיין</div>
            ):(
              activityLog.map((entry,i)=>(
                <div key={i} style={{padding:'8px 12px',borderRadius:'10px',background:entry.type==='start'||entry.type==='done'?'rgba(99,102,241,0.08)':entry.type==='error'?'rgba(248,113,113,0.08)':entry.type==='insight'?'rgba(16,185,129,0.08)':'rgba(255,255,255,0.03)',border:`1px solid ${entry.type==='error'?'rgba(248,113,113,0.15)':entry.type==='insight'?'rgba(16,185,129,0.15)':'rgba(255,255,255,0.05)'}`,marginBottom:'6px',animation:'fadeIn 0.3s ease'}}>
                  <div style={{display:'flex',gap:'8px',alignItems:'flex-start'}}>
                    <span style={{fontSize:'10px',color:'#475569',flexShrink:0,marginTop:'2px'}}>{entry.time}</span>
                    <span style={{fontSize:'12px',color:entry.type==='error'?'#f87171':entry.type==='done'?'#4ade80':entry.type==='insight'?'#34d399':'#94a3b8',lineHeight:1.5}}>{entry.text}</span>
                  </div>
                </div>
              ))
            )}
          </div>
        )}
      </div>

      {/* Bottom Nav */}
      <div style={{display:'flex',background:'rgba(15,15,26,0.95)',borderTop:'1px solid rgba(255,255,255,0.07)',padding:'6px 0 8px'}}>
        {panels.map((panel,i)=>(
          <button key={i} onClick={()=>setActivePanel(i)} style={{flex:1,display:'flex',flexDirection:'column',alignItems:'center',gap:'3px',padding:'6px 0',background:'none',border:'none',cursor:'pointer',color:activePanel===i?'#6366f1':'#475569',transition:'color 0.2s ease'}}>
            <span style={{fontSize:'20px'}}>{panel.icon}</span>
            <span style={{fontSize:'10px',fontWeight:activePanel===i?600:400}}>{panel.label}</span>
            {activePanel===i&&<div style={{width:'20px',height:'2px',borderRadius:'1px',background:'#6366f1',marginTop:'1px'}}/>}
          </button>
        ))}
      </div>
    </div>
  )
}
